+        '--seeds','1100,1101,1102,1103,1104,1105,1106,1107','--phis=-45,45','--calibration',
+        'runs/task-v9-frozen/calibration.json','--role','test','--registration',stress_reg]
+    log=(AUDIT/'stress-launcher.log').open('x')
